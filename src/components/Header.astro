---
import { site } from '../site.config';
import { withBase } from '../utils/paths';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { label: 'blog', href: withBase('blog/'), icon: 'blog' },
  { label: 'projects', href: withBase('projects/'), icon: 'projects' },
  { label: 'about', href: withBase('about/'), icon: 'about' },
] as const;
const path = Astro.url.pathname;
const home = withBase();
const topics = withBase('tags/');
---

<header class="site-header" data-site-header>
  <button type="button" class="nav-dock nav-launch" data-nav-launch aria-label="Open navigation menu" aria-expanded="false" aria-controls="site-navigation" hidden>
    <span class="monogram" aria-hidden="true">{site.mark}</span>
    <Icon name="menu" size={18} />
  </button>
  <nav class="nav-dock site-nav" id="site-navigation" aria-label="Main navigation">
    <a class="nav-brand" href={home} aria-label={site.title + ', home'} aria-current={path === home ? 'page' : undefined}>
      <span class="monogram nav-monogram" aria-hidden="true">{site.mark}</span>
      <span class="wordmark">{site.title}</span>
    </a>
    {links.map(({ href, icon, label }) => (
      <a class="nav-link" href={href} aria-label={label} aria-current={path === href ? 'page' : path.startsWith(href) ? 'location' : undefined}>
        <Icon name={icon} /><span class="nav-label">{label}</span>
      </a>
    ))}
    <details class="nav-more">
      <summary class="nav-link" aria-label="More">
        <Icon name="more" /><span class="nav-label">more</span>
      </summary>
      <div class="nav-panel">
        <a href={topics} aria-current={path === topics ? 'page' : path.startsWith(topics) ? 'location' : undefined}>tags</a>
        <a href={withBase('rss.xml')}><Icon name="rss" /> rss</a>
        <ThemeToggle />
      </div>
    </details>
    <button type="button" class="nav-link nav-close" data-nav-close aria-label="Close navigation menu" hidden><Icon name="close" size={18} /></button>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const launch = header?.querySelector<HTMLButtonElement>('[data-nav-launch]');
  const close = header?.querySelector<HTMLButtonElement>('[data-nav-close]');
  const firstLink = header?.querySelector<HTMLAnchorElement>('.nav-brand');
  const more = header?.querySelector<HTMLDetailsElement>('.nav-more');

  if (header && launch && close && firstLink && more) {
    const dock = header;
    const launchButton = launch;
    const first = firstLink;
    const moreMenu = more;

    dock.dataset.enhanced = '';
    launch.hidden = false;
    close.hidden = false;

    function setOpen(open: boolean) {
      dock.toggleAttribute('data-open', open);
      launchButton.setAttribute('aria-expanded', String(open));
      if (!open) moreMenu.open = false;
      (open ? first : launchButton).focus();
    }

    launch.addEventListener('click', () => setOpen(true));
    close.addEventListener('click', () => setOpen(false));

    moreMenu.addEventListener('focusout', (event) => {
      if (event.relatedTarget instanceof Node && !moreMenu.contains(event.relatedTarget)) {
        moreMenu.open = false;
      }
    });

    document.addEventListener('pointerdown', (event) => {
      if (!(event.target instanceof Node)) return;
      if (!moreMenu.contains(event.target)) moreMenu.open = false;
      if (!dock.contains(event.target) && dock.hasAttribute('data-open')) {
        dock.removeAttribute('data-open');
        launchButton.setAttribute('aria-expanded', 'false');
      }
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || event.defaultPrevented) return;
      if (moreMenu.open) {
        event.preventDefault();
        moreMenu.open = false;
        moreMenu.querySelector('summary')?.focus();
      } else if (dock.hasAttribute('data-open') && getComputedStyle(close).display !== 'none') {
        event.preventDefault();
        setOpen(false);
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 18px;
    z-index: 25;
    overflow-anchor: none;
    display: flex;
    justify-content: center;
    margin-top: 22px;
    padding-inline: 12px;
    pointer-events: none;
  }
  .nav-dock {
    position: relative;
    display: flex;
    align-items: center;
    padding: 4px;
    gap: 3px;
    max-width: 100%;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--panel) 94%, transparent);
    backdrop-filter: blur(12px);
    box-shadow: 0 8px 28px #0002;
    pointer-events: auto;
  }
  .nav-brand, .nav-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 44px;
    padding: 0 17px;
    border-radius: 999px;
    color: var(--muted);
    font-size: 14px;
    text-decoration: none;
    white-space: nowrap;
    touch-action: manipulation;
  }
  .nav-brand { padding: 0 13px; }
  .monogram { font-size: 18px; line-height: 1; color: var(--ink); }
  .nav-monogram { display: none; }
  .wordmark { font-size: 16px; letter-spacing: -.035em; }
  .nav-launch, .nav-close { display: none; }
  .nav-link:is(:hover, [aria-current]), .nav-brand:is(:hover, [aria-current]), .nav-more[open] summary {
    background: var(--area);
    color: var(--accent);
  }
  .nav-more summary { cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .nav-panel {
    position: absolute;
    inset: calc(100% + 10px) 0 auto auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: min(235px, calc(100vw - 32px));
    max-height: min(320px, calc(100dvh - 92px));
    overflow: auto;
    overscroll-behavior: contain;
    padding: 8px;
    border: 1px solid var(--line);
    border-radius: var(--radius-panel);
    background: var(--panel);
    box-shadow: 0 10px 35px #0003;
  }
  .nav-more:not([open]) > .nav-panel { display: none; }
  .nav-panel > :global(:is(a, button)) {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-inline: 12px;
    min-height: 44px;
    border-radius: var(--radius-control);
    font-size: var(--text-supporting);
    text-decoration: none;
  }
  .nav-panel > :global(button) { grid-column: 1 / -1; }
  .nav-panel > :global(:is(a, button):is(:hover, :focus-visible, [aria-current])) { background: var(--area); color: var(--accent); }

  @media (max-width: 760px), (pointer: coarse), (max-width: 1024px) and (max-height: 540px) {
    :global(html) { scroll-padding-bottom: calc(75px + env(safe-area-inset-bottom)); }
    :global(body) { padding-bottom: calc(70px + env(safe-area-inset-bottom)); }
    .site-header { position: fixed; inset: auto 0 max(12px, env(safe-area-inset-bottom)); margin: 0; }
    .nav-dock { gap: 2px; padding: 3px; }
    .nav-brand, .nav-link { width: 44px; padding: 0; }
    .wordmark, .nav-label { display: none; }
    .nav-monogram { display: inline; }
    .nav-panel { inset: auto 0 calc(100% + 10px) auto; }
    .site-header[data-enhanced]:not([data-open]) { justify-content: flex-end; }
    [data-enhanced]:not([data-open]) .site-nav { display: none; }
    [data-enhanced]:not([data-open]) .nav-launch {
      display: flex;
      min-width: 80px;
      min-height: 52px;
      justify-content: center;
      gap: 10px;
      color: var(--muted);
    }
    [data-open] .nav-close { display: flex; }
  }
</style>
